---
import Layout from '../layouts/Layout.astro';
import HealthStatus from '../components/HealthStatus.tsx';
import OllamaStatus from '../components/OllamaStatus.tsx';
---

<Layout title="Dashboard">
  <header class="page-header">
    <div>
      <h1>Dashboard</h1>
      <p class="subtitle">Your local coding assistant. It works when you decide.</p>
    </div>
  </header>

  <section class="grid">
    <HealthStatus client:load />
    <OllamaStatus client:load />

    <a class="card card-link" href="/repositories">
      <div class="card-head">
        <h2>Repositories</h2>
        <span class="arrow" aria-hidden="true">→</span>
      </div>
      <p>
        Add a local repository, find tasks with rules or ask Gemma for ideas, and open “How to fix” to see where
        each problem is and how to solve it.
      </p>
    </a>
  </section>
</Layout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
  }

  .subtitle {
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .card {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card h2 {
    font-size: 1rem;
    font-weight: 600;
  }

  .card p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .card-link {
    border-style: solid;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .card-link:hover {
    border-color: var(--color-accent-strong);
    text-decoration: none;
  }

  .arrow {
    color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .page-header {
      flex-direction: column;
    }
  }
</style>
