---
import Layout from '../layouts/Layout.astro';
import HealthStatus from '../components/HealthStatus.tsx';
import OllamaStatus from '../components/OllamaStatus.tsx';

const placeholders = [
  { title: 'Approved tasks', text: 'Tasks ready to run will show up here.', phase: 'Phase 6' },
  { title: 'Recent sessions', text: 'History of Work Sessions and their reports.', phase: 'Phase 6' },
];
---

<Layout title="Dashboard">
  <header class="page-header">
    <div>
      <h1>Dashboard</h1>
      <p class="subtitle">Your local coding assistant. It works when you decide.</p>
    </div>
    <button class="primary" type="button" disabled title="Available in Phase 6">
      Start Work Session
    </button>
  </header>

  <section class="grid">
    <HealthStatus client:load />
    <OllamaStatus client:load />

    <a class="card card-link" href="/repositories">
      <div class="card-head">
        <h2>Repositories</h2>
        <span class="arrow" aria-hidden="true">→</span>
      </div>
      <p>Add a local repository and analyze its structure, languages and stack.</p>
    </a>

    {
      placeholders.map((card) => (
        <article class="card">
          <div class="card-head">
            <h2>{card.title}</h2>
            <span class="phase">{card.phase}</span>
          </div>
          <p>{card.text}</p>
        </article>
      ))
    }
  </section>
</Layout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
  }

  .subtitle {
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .primary {
    padding: var(--space-3) var(--space-6);
    background: var(--color-accent-strong);
    color: var(--color-text);
    border: none;
    border-radius: var(--radius-md);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .primary:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .card {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card h2 {
    font-size: 1rem;
    font-weight: 600;
  }

  .card p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .card-link {
    border-style: solid;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .card-link:hover {
    border-color: var(--color-accent-strong);
    text-decoration: none;
  }

  .arrow {
    color: var(--color-accent);
  }

  .phase {
    font-size: 0.7rem;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 0 var(--space-2);
    border-radius: 999px;
  }

  @media (max-width: 720px) {
    .page-header {
      flex-direction: column;
    }
  }
</style>
