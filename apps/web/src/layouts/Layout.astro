---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/', label: 'Dashboard' },
  { href: '/repositories', label: 'Repositories' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Sleepy Coder</title>
    <script is:inline>
      // Apply the saved theme before the page paints (no flash of the wrong theme).
      try {
        const theme = localStorage.getItem('sleepy-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked: follow the system setting.
      }
    </script>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <a href="/" class="brand">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="7" />
            <text x="13" y="24" font-size="19">z</text>
            <text x="23.5" y="13.5" font-size="10" class="small-z">z</text>
          </svg>
          <span>Sleepy Coder</span>
        </a>
        <nav>
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={['nav-link', { active: currentPath === item.href }]}
                    aria-current={currentPath === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="theme-switch" role="group" aria-label="Theme">
          <button type="button" data-theme-choice="auto">Auto</button>
          <button type="button" data-theme-choice="light">Light</button>
          <button type="button" data-theme-choice="dark">Dark</button>
        </div>
        <p class="tagline">Let your code sleep.</p>
      </aside>
      <main class="content">
        <slot />
      </main>
    </div>
    <script is:inline>
      // Theme switch: "Auto" follows the system; Light/Dark are remembered in this browser.
      (() => {
        const buttons = document.querySelectorAll('[data-theme-choice]');
        const current = () => document.documentElement.dataset.theme ?? 'auto';
        const paint = () =>
          buttons.forEach((button) =>
            button.setAttribute('aria-pressed', String(button.dataset.themeChoice === current())),
          );
        buttons.forEach((button) =>
          button.addEventListener('click', () => {
            const choice = button.dataset.themeChoice;
            if (choice === 'auto') delete document.documentElement.dataset.theme;
            else document.documentElement.dataset.theme = choice;
            try {
              if (choice === 'auto') localStorage.removeItem('sleepy-theme');
              else localStorage.setItem('sleepy-theme', choice);
            } catch {
              // Storage blocked: the choice lasts until the page is reloaded.
            }
            paint();
          }),
        );
        paint();
      })();
    </script>
  </body>
</html>

<style>
  .shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    min-height: 100vh;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-4);
    background: var(--color-surface);
    border-right: 1px solid var(--color-border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: 700;
    font-size: 1.05rem;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-mark {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
  }

  .brand-mark rect {
    fill: var(--color-accent-soft);
  }

  .brand-mark text {
    fill: var(--color-accent);
    font-family: var(--font-sans);
    font-weight: 700;
    text-anchor: middle;
  }

  .brand-mark .small-z {
    opacity: 0.65;
  }

  nav ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }

  .nav-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  .nav-link:hover {
    background: var(--color-surface-raised);
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-link.active {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .tagline {
    margin-top: auto;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .theme-switch {
    display: flex;
    padding: 2px;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .theme-switch button {
    flex: 1;
    padding: 2px var(--space-2);
    background: none;
    border: none;
    border-radius: 4px;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .theme-switch button:hover {
    color: var(--color-text);
  }

  .theme-switch button[aria-pressed='true'] {
    background: var(--color-surface);
    color: var(--color-accent);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
  }

  /* Components adapt to the space they get (container queries), not to the window size. */
  .content {
    container-type: inline-size;
    min-width: 0;
    width: 100%;
    max-width: 1100px;
    padding: var(--space-8);
    margin-bottom: 20rem;
  }

  /* Medium and small screens: the sidebar becomes a bar at the top. */
  @media (max-width: 900px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }

    .sidebar {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-6);
      padding: var(--space-3) var(--space-4);
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    nav ul {
      display: flex;
      flex-wrap: wrap;
    }

    .theme-switch {
      margin-left: auto;
    }

    .tagline {
      display: none;
    }

    .content {
      padding: var(--space-6) var(--space-4);
    }
  }
</style>